{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@api": ["apps/api/src/app.ts"],
      "@api/*": ["apps/api/src/*"],
      "@shared": ["packages/shared/src/index.ts"],
      "@shared/*": ["packages/shared/src/*"],
      "@video/*": ["apps/remotion/src/*"],

      /* apps/api's own internal aliases — re-declared here so that any package
       * pulling in its source through the @api/* alias above (e.g. packages/shared
       * importing type { presentPlayerRecap } from '@api/routes/recap/model') can
       * still resolve them. Package-local paths in apps/api/tsconfig.json only
       * apply when tsc runs *from* apps/api itself. */
      "#env": ["apps/api/src/env.ts"],
      "#recap/*": ["apps/api/src/routes/recap/*"],
      "#search/*": ["apps/api/src/routes/search/*"],
      "#libs/*": ["apps/api/src/libs/*"],
      "#/graphql": ["apps/api/src/libs/startgg/graphql.ts"],
      "#/graphql-env": ["apps/api/src/libs/startgg/graphql-env.d.ts"]
    }
  }
}
