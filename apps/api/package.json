{
  "name": "api",
  "version": "1.0.50",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server src/index.ts"
  },
  "imports": {
    "#env": "./src/env.ts",
    "#plugins/*": "./src/plugins/*.ts",
    "#recap/*": "./src/routes/recap/*.ts",
    "#search/*": "./src/routes/search/*.ts",
    "#libs/*": "./src/libs/*.ts",
    "#/graphql": "./src/libs/startgg/graphql.ts",
    "#/graphql-env": "./src/libs/startgg/graphql-env.d.ts",
    "#tests/*": "./tests/*.ts"
  },
  "dependencies": {
    "@elysia/cors": "rc",
    "@elysia/openapi": "rc",
    "@elysia/static": "rc",
    "@sinclair/typebox": "^0.34.0",
    "elysia": "rc",
    "gql.tada": "^1.11.3",
    "graphql": "^17.0.2",
    "typebox": "^1.4.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "bun-types": "latest",
    "fishery": "^2.4.0",
    "typescript": "~5.9.3"
  },
  "module": "src/index.js"
}
