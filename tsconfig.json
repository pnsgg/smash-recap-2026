{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build",
    "paths": {
      "#app/*": ["./app/*"],
      "#recap/*": ["./app/recap/*"],
      "#search/*": ["./app/search/*"],
      "#shared/*": ["./app/shared/*"],
      "#tests/*": ["./tests/*"],
      "#/graphql": ["./app/shared/infrastructure/secondary/startgg/graphql.ts"],
      "#/graphql-env": ["./app/shared/infrastructure/secondary/startgg/graphql-env.d.ts"]
    }
  },
  "exclude": [
    "tests",
    "build",
    "node_modules"
  ]
}
